# Copy to .env — never commit .env
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
DIAL_API_KEY=
DIAL_FROM_NUMBER_ID=
# Teammate's phone (E.164). Every Dial call is real and billed.
PHYSICIAN_PHONE=+14155550100
# Must be a SECOND Dial number for SMS to work (US 10DLC blocks SMS to real phones). Leave blank to simulate.
PATIENT_PHONE=
PAYER_ADAPTER=mock
CHAOS_P500=0.3
CHAOS_PTIMEOUT=0.1
CHAOS_PPEND=0.3
PORT=4000
LOG_LEVEL=info
DB_PATH=./data/priorauth.db
